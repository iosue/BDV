CREATE TABLE Cart (
  cart_id INT AUTO_INCREMENT PRIMARY KEY,
  user_id INT
);

CREATE TABLE Item_Family (
  item_id INT AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(32),
  description VARCHAR(255)
);

CREATE TABLE Item_Variant (
  SKU INT AUTO_INCREMENT,
  item_id INT,
  description VARCHAR(255),
  size VARCHAR(4),
  color VARCHAR(16),
  price DECIMAL(8,2),
  PRIMARY KEY (SKU),
  FOREIGN KEY (item_id) REFERENCES Item_Family(item_id)
);

CREATE TABLE Cart_Line (
  line_id INT AUTO_INCREMENT,
  cart_id INT,
  SKU INT,
  quantity INT,
  PRIMARY KEY (line_id),
  FOREIGN KEY (cart_id) REFERENCES Cart(cart_id),
  FOREIGN KEY (SKU) REFERENCES Item_Variant(SKU)
);

CREATE TABLE Payment_Type (
  pay_type_id INT AUTO_INCREMENT,
  value VARCHAR(32),
  PRIMARY KEY (pay_type_id)
);

CREATE TABLE Country (
  country_id INT AUTO_INCREMENT,
  name VARCHAR(32),
  PRIMARY KEY (country_id)
);

CREATE TABLE User (
  user_id INT AUTO_INCREMENT,
  full_name VARCHAR(50),
  email VARCHAR(50),
  password VARCHAR(255),
  PRIMARY KEY (user_id)
);

CREATE TABLE Address (
  address_id INT AUTO_INCREMENT,
  user_id INT,
  street VARCHAR(50),
  city VARCHAR(50),
  postal_code VARCHAR(12),
  country_id INT,
  PRIMARY KEY (address_id),
  FOREIGN KEY (country_id) REFERENCES Country(country_id),
  FOREIGN KEY (user_id) REFERENCES User(user_id)
);

CREATE TABLE User_Pay (
  payer_id INT AUTO_INCREMENT,
  user_id INT,
  pay_type_id INT,
  acct_number VARCHAR(32),
  expiry_date DATE,
  billing_address INT,
  PRIMARY KEY (payer_id),
  FOREIGN KEY (pay_type_id) REFERENCES Payment_Type(pay_type_id),
  FOREIGN KEY (billing_address) REFERENCES Address(address_id),
  FOREIGN KEY (user_id) REFERENCES User(user_id)
);

CREATE TABLE Order_Status (
  status_code INT AUTO_INCREMENT,
  status VARCHAR(32),
  PRIMARY KEY (status_code)
);

CREATE TABLE Orders (
  order_id INT AUTO_INCREMENT,
  user_id INT,
  pay_id INT,
  order_date DATE,
  shipping_address INT,
  shipping_date DATE,
  order_total DECIMAL(8,2),
  status INT,
  PRIMARY KEY (order_id),
  FOREIGN KEY (pay_id) REFERENCES User_Pay(payer_id),
  FOREIGN KEY (status) REFERENCES Order_Status(status_code),
  FOREIGN KEY (shipping_address) REFERENCES Address(address_id),
  FOREIGN KEY (user_id) REFERENCES User(user_id)
);

CREATE TABLE Order_Line (
  line_id INT AUTO_INCREMENT,
  order_id INT,
  SKU INT,
  quantity INT,
  price DECIMAL(8,2),
  PRIMARY KEY (line_id),
  FOREIGN KEY (SKU) REFERENCES Item_Variant(SKU),
  FOREIGN KEY (order_id) REFERENCES Orders(order_id)
);
